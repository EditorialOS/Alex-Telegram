# ── Self-hosting Alex (no Replit) ──────────────────────────────────────────
# Copy to .env and fill in. Load it however you run the server (e.g. `--env-file`).

# Server
PORT=8080
NODE_ENV=production
# Your PUBLIC https origin (used for the Telegram webhook + onboarding wizard).
# Local dev: a tunnel URL, e.g. https://your-name.trycloudflare.com
PUBLIC_BASE_URL=https://alex.example.com

# Model (direct Anthropic API — no Replit AI proxy)
ANTHROPIC_API_KEY=sk-ant-...

# Database (any Postgres: local Docker, Neon, Supabase, RDS, …)
DATABASE_URL=postgres://user:pass@host:5432/alex

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-from-BotFather
TELEGRAM_WEBHOOK_SECRET=change-me-openssl-rand-hex-32

# Wizard setup-token signing (any random string)
SESSION_SECRET=change-me-random

# ── Optional ────────────────────────────────────────────────────────────────
# Voice memos (Whisper). Omit to disable voice gracefully.
OPENAI_API_KEY=sk-...
# Conversation memory / notes (Context API). Omit to disable memory gracefully.
CONTEXT_API_KEY=
# CONTEXT_API_BASE_URL=http://host:8080/api

# Slack (only if you also run the Slack surface; not needed for Telegram-only)
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# Google Drive auto-filing requires Replit Connectors and is skipped off-Replit
# (generation still works; approved output just isn't filed to Drive).

# ── Alex Story Desk (private ChatGPT MCP) ──────────────────────────────────
# ALEX_SOURCE_ROOT must be a mounted, unpacked minimal-os directory containing
# MANIFEST.json, Alex-Final.md and skills/. Do not point it at this repository.
ALEX_SOURCE_ROOT=/opt/alex-source/minimal-os
STORY_DESK_CONTRACT_ROOT=/app/story-desk/contracts
STORY_DESK_MODEL=claude-sonnet-4-6

# Private ChatGPT authentication through Supabase Auth OAuth 2.1. The resource
# URL is the exact public MCP endpoint and must also be the access-token aud.
SUPABASE_AUTH_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
STORY_DESK_RESOURCE_URL=https://YOUR_APPROVED_HOST/api/mcp
# Derived from SUPABASE_AUTH_ISSUER by default; override only for a proxy/test.
# STORY_DESK_OAUTH_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Box Client Credentials Grant (one service account; deployment secrets only)
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=

# Optional for local/mocked Box endpoints
# BOX_API_BASE_URL=https://api.box.com/2.0
# BOX_UPLOAD_BASE_URL=https://upload.box.com/api/2.0
# BOX_TOKEN_URL=https://api.box.com/oauth2/token
