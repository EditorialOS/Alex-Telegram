# Alex Core / Story Desk
#
# This file is documentation, not a secret store. Use Vercel environment
# variables for deployments and a private, untracked env file for local work.

# Local container/server settings. Vercel supplies its own function runtime.
NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# Supabase Postgres remains the business system of record.
DATABASE_URL=postgres://user:pass@host:5432/alex

# Vercel AI Gateway. Vercel deployments use their injected VERCEL_OIDC_TOKEN;
# set an API key only for local/CI calls. The model includes a provider prefix.
AI_GATEWAY_API_KEY=
STORY_DESK_MODEL=anthropic/claude-opus-4.6
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh

# Supabase Auth OAuth 2.1 for the private ChatGPT remote MCP connection.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUTH_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
STORY_DESK_RESOURCE_URL=https://YOUR_APPROVED_HOST/api/mcp
# Derived from SUPABASE_AUTH_ISSUER by default; override only for a proxy/test.
# STORY_DESK_OAUTH_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# At least 32 random characters in production. Signs one-hour, tenant-bound
# opportunity-board and brief download URLs.
STORY_DESK_DOWNLOAD_SECRET=

# Minimal OS 2.1 and the Story Desk contract are vendored in the repository and
# discovered automatically. These are local/test overrides only.
# ALEX_SOURCE_ROOT=/absolute/path/to/sources/minimal-os/2.1.0
# STORY_DESK_CONTRACT_ROOT=/absolute/path/to/story-desk/contracts
